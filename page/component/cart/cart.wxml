<view class="main">
  <view wx:if="{{hasList}}">
    <view class="cart-box">
      <view class="cart-list" wx:for="{{carts}}" wx:key="id">
        <!-- 选中按钮 -->
        <icon wx:if="{{item.selected}}" type="success" color="red" data-index="{{index}}" class="cart-pro-select" bindtap="selectList" />
        <icon wx:else type="circle" class="cart-pro-select" data-index="{{index}}" bindtap="selectList" />

        <!-- 商品图片 -->
        <navigator url="../details/details?id={{item.id}}">
          <image class="cart-thumb" src="{{item.image}}" />
        </navigator>
        
        <!-- 商品名称 -->
        <text class="cart-pro-name">{{item.name}}</text>
        <!-- 商品价格 -->
        <text class="cart-pro-price">￥{{item.price}}</text>
        
        <!-- 数量加减 -->
        <view class="cart-count-box">
          <text class="cart-count-down" bindtap="minusCount" data-index="{{index}}">-</text>
          <text class="cart-count-num">{{item.count}}</text>
          <text class="cart-count-add" bindtap="addCount" data-index="{{index}}">+</text>
        </view>
        
        <!-- 删除 -->
        <text class="cart-del" bindtap="deleteList" data-index="{{index}}">×</text>
      </view>
    </view>

    <!-- 底部栏：全选 + 合计 + 去付款 -->
    <view class="cart-footer">
      <view class="left-group">
        <icon wx:if="{{selectAllStatus}}" type="success_circle" color="#ff4d4f" bindtap="selectAll" />
        <icon wx:else type="circle" color="#999" bindtap="selectAll"></icon>
        <text class="all-text">全选</text>
      </view>

      <view class="right-group">
        <text class="cart-total-price">合计：￥{{totalPrice}}</text>
        <button class="pay-btn" bindtap="toPay" disabled="{{totalPrice <= 0}}">去结算</button>
      </view>
    </view>
  </view>

  <!-- 空购物车 -->
  <view wx:else>
    <view class="cart-no-data">购物车是空的哦</view>
  </view>
</view>