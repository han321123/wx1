.main {
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: 120rpx;
}
.cart-box {
  padding: 20rpx;
}
.cart-list {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f4f4f4;
}
.cart-pro-select {
  margin-right: 15rpx;
}
.cart-thumb {
  width: 120rpx;
  height: 120rpx;
  margin-right: 20rpx;
}
.cart-pro-name {
  flex: 1;
  font-size: 28rpx;
}
.cart-pro-price {
  color: red;
  margin-right: 20rpx;
}
.cart-count-box {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}
.cart-count-down,
.cart-count-add {
  padding: 0 15rpx;
  border: 1rpx solid #eee;
}
.cart-count-num {
  padding: 0 15rpx;
}
.cart-del {
  color: #999;
  font-size: 32rpx;
}

/* 底部栏 */
.cart-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100rpx;
  background: #fff;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 30rpx;
  box-sizing: border-box;
  border-top: 1rpx solid #eee;
}
.left-group {
  display: flex;
  align-items: center;
}
.all-text {
  margin-left: 10rpx;
}
.right-group {
  display: flex;
  align-items: center;
}
.cart-total-price {
  color: red;
  margin-right: 20rpx;
  font-weight: bold;
}
.pay-btn {
  background: red;
  color: #fff;
  border-radius: 50rpx;
  font-size: 28rpx;
  padding: 10rpx 30rpx;
}
.pay-btn[disabled] {
  background: #ccc;
}
.cart-no-data {
  text-align: center;
  padding-top: 200rpx;
  color: #999;
}