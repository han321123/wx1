<view class="container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <input placeholder="搜索商品" bindinput="onSearch" />
  </view>

  <!-- 商品列表 -->
  <view class="goods-list">
    <view class="goods-item" wx:for="{{goodsList}}" wx:key="id" bindtap="goDetail" data-item="{{item}}">
      <image src="{{item.thumb}}" class="goods-img" mode="aspectFill"></image>
      <view class="goods-info">
        <view class="goods-name">{{item.name}}</view>
        <view class="goods-price">¥{{item.price}}</view>
        <button class="add-cart" data-item="{{item}}" bindtap="addToCart">加入购物车</button>
      </view>
    </view>
  </view>

  <!-- 无数据 -->
  <view wx:if="{{goodsList.length === 0}}" class="empty">
    暂无商品
  </view>
</view>