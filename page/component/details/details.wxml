<view class="main">
  <view class="goods-box">
  
    <image src="{{goods.image}}" class="goods-thumb"></image>

    <navigator open-type="switchTab" url="../cart/cart">
      <view class="carts-icon">
        <image src="/image/cart2.png"></image>
        <text class="carts-icon-num" wx:if="{{totalNum > 0}}">{{totalNum}}</text>
      </view>
    </navigator>

    <view class="goods-title">{{goods.title}}</view>
    <view class="goods-price">￥{{goods.price}}</view>
    <view class="goods-stock">库存：{{goods.stock}}</view>

    <view class="num-box">
      <text bindtap="minusCount" class="num-btn">-</text>
      <text class="num">{{count}}</text>
      <text bindtap="addCount" class="num-btn">+</text>
    </view>

    <view class="add-cart" bindtap="addToCart">加入购物车</view>
  </view>

  <view class="goods-tab-box">
    <view class="tab {{curIndex===0?'on':''}}" bindtap="bindTap" data-index="0">商品详情</view>
    <view class="tab {{curIndex===1?'on':''}}" bindtap="bindTap" data-index="1">产品参数</view>
    <view class="tab {{curIndex===2?'on':''}}" bindtap="bindTap" data-index="2">售后保障</view>
  </view>

  <view class="content">
    <view wx:if="{{curIndex===0}}">{{goods.detail}}</view>
    <view wx:if="{{curIndex===1}}">{{goods.parameter}}</view>
    <view wx:if="{{curIndex===2}}">{{goods.service}}</view>
  </view>
</view>