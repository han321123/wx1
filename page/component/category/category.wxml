<view class="main">
  <!-- 左侧分类 -->
  <view class="categroy-left">
    <view wx:for="{{category}}" wx:key="id" data-id="{{item.id}}" data-index="{{index}}" bindtap="switchTab" class="cate-list {{curIndex === index ? 'on' : ''}}">
      {{item.name}}
    </view>
  </view>

  <!-- 右侧商品 -->
  <view class="categroy-right">
    <scroll-view scroll-y class="right-scroll">
      <view wx:for="{{detail}}" wx:key="id" wx:if="{{curIndex == index}}">
        <view class="cate-banner">
          <image src="{{item.banner}}" mode="widthFix"></image>
        </view>

        <view class="cate-title">
          <text>{{item.cate}}</text>
        </view>

        <!-- 商品列表 -->
        <view class="product">
          <view class="product-list" wx:for="{{item.products}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
            <!-- 这里是商品ID ✅ -->

            <image src="{{item.image}}" mode="aspectFill"></image>
            <view class="product-name">{{item.name}}</view>
            <view class="product-price">¥{{item.price}}</view>

            <button class="add-cart-btn" data-item="{{item}}" bindtap="addToCart">
              加入购物车
            </button>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>