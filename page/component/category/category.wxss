.main {
  display: flex;
  height: 100vh;
}

/* 左侧 */
.categroy-left {
  width: 140rpx;
  background: #f5f5f5;
  height: 100%;
}
.cate-list {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
}
.cate-list.on {
  background: #fff;
  color: #AB956D;
  font-weight: bold;
}

/* 右侧 */
.categroy-right {
  height: 100vh;
  flex: 1;
  background: #fff;
}
.right-scroll {
  /* height: 100%; */
  height: 100vh;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 分类banner */
.cate-banner image {
  width: 100%;
  border-radius: 16rpx;
}
.cate-title {
  padding: 20rpx 0;
  font-size: 32rpx;
  font-weight: bold;
}

/* 商品 */
.product {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.product-list {
  width: 48%;
  margin-bottom: 30rpx;
}
.product-list image {
  width: 100%;
  height: 260rpx;
  border-radius: 16rpx;
}
.product-name {
  font-size: 26rpx;
  margin-top: 10rpx;
}
.product-price {
  color: red;
  font-size: 28rpx;
  margin-top: 10rpx;
}
.add-cart-btn {
  background: #ff4444;
  color: #fff;
  font-size: 24rpx;
  padding: 0;
  margin: 10rpx 0;
  height: 60rpx;
  line-height: 60rpx;
}