.main {
  padding: 0 20rpx;
  background: #fff;
  min-height: 100vh;
}

/* 搜索栏 */
.search-header {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  gap: 20rpx;
}
.search-input-box {
  flex: 1;
  position: relative;
}
.search-input {
  width: 100%;
  height: 70rpx;
  line-height: 70rpx;
  padding: 0 20rpx 0 54rpx;
  background: #f8f8f8;
  border-radius: 35rpx;
  font-size: 32rpx;
  border: 2rpx solid #eee;
  box-sizing: border-box;
}
.search-input-box icon {
  position: absolute;
  left: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 1;
}
.cancel-btn {
  font-size: 32rpx;
  color: #AB956D;
  line-height: 70rpx;
}

/* 搜索建议 */
.keywords {
  position: absolute;
  width: 100%;
  left: 0;
  top: 90rpx;
  background: #fff;
  z-index: 999;
  padding: 20rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}
.keywords-item {
  line-height: 70rpx;
  border-bottom: 1rpx solid #eee;
  color: #787878;
  font-size: 28rpx;
  padding: 0 20rpx;
}

/* 标题 */
.title {
  font-size: 32rpx;
  margin: 30rpx 0;
}
.title text {
  padding-right: 30rpx;
  padding-bottom: 10rpx;
  color: #AB956D;
  border-bottom: 8rpx solid #AB956D;
}

/* 标签 */
.tags text {
  display: inline-block;
  font-size: 28rpx;
  padding: 6rpx 20rpx;
  border: 2rpx solid #ddd;
  color: #aaa;
  margin: 0 30rpx 20rpx 0;
  border-radius: 40rpx;
  word-break: break-all;
  background: #f5f5f5;
}

/* 结果 */
.result {
  margin-top: 40rpx;
}
.result-box, .recommend-box {
  padding: 0 20rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.result-list {
  width: 48%;
  margin-bottom: 30rpx;
  background: #f5f6f5;
  border-radius: 10rpx;
  text-align: center;
  padding: 20rpx 0;
  box-sizing: border-box;
}
.result-list image {
  width: 175rpx;
  height: 175rpx;
  border-radius: 10rpx;
  margin: 0 auto 10rpx;
}
.result-info {
  padding: 0 10rpx;
}
.result-name {
  font-size: 28rpx;
  margin-bottom: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.result-price {
  color: red;
  font-size: 32rpx;
}
.null-tips {
  padding: 200rpx 0;
  text-align: center;
  color: #787878;
  font-size: 32rpx;
}

/* 相关推荐 */
.recommend-title {
  position: relative;
  height: 0;
  width: 100%;
  border-bottom: 1rpx solid #f0f0f1;
  margin: 42rpx 0;
}
.recommend-title text {
  position: absolute;
  left: 50%;
  top: -20rpx;
  width: 150rpx;
  height: 40rpx;
  margin-left: -75rpx;
  line-height: 40rpx;
  background: #ffffff;
  color: #5e5e5e;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
  letter-spacing: 1px;
}