.main {
  padding: 20rpx;
  background: #fff;
  min-height: 100vh;
}
.header {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
}
.thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}
.nickname {
  font-size: 32rpx;
  font-weight: bold;
}
.about {
  margin-left: auto;
  font-size: 26rpx;
  color: #666;
}
.address-box {
  margin-top: 30rpx;
}
.address-manage {
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
}
.address-list {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid #eee;
  border-radius: 10rpx;
}
.orders-box {
  margin-top: 30rpx;
}
.orders {
  padding: 25rpx;
  background: #f5f5f5;
  border-radius: 10rpx;
  text-align: center;
}
.avatar-btn {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
}
.avatar-btn::after {
  border: none;
}
.thumb {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
}
.nickname {
  font-size: 30rpx;
  margin-left: 20rpx;
}