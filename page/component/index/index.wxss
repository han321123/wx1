/* 全局容器 */
.container {
  background: #fafafa;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 轮播 */
.banner {
  width: 100%;
  height: 400rpx;
}
.banner-img {
  width: 100%;
  height: 100%;
}

/* 搜索 */
.search-wrap {
  padding: 20rpx 30rpx;
}
.search-box {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  height: 70rpx;
  border-radius: 50rpx;
  color: #999;
  font-size: 26rpx;
}
.search-box icon {
  margin-right: 10rpx;
}

/* 模块标题 */
.section {
  margin-top: 20rpx;
  padding: 0 30rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #ab956d;
  margin-bottom: 20rpx;
}

/* 网格布局 */
.grid-box {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.grid-item {
  width: 48%;
  height: 320rpx;
  border-radius: 12rpx;
  overflow: hidden;
}
.grid-item.big {
  width: 100%;
  height: 320rpx;
}
.grid-item image {
  width: 100%;
  height: 100%;
}

/* 商品列表 */
.goods-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.goods-item {
  width: 47%;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  text-align: center;
}
.goods-item image {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 10rpx;
}
.goods-item .name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 10rpx;
}
.goods-item .price {
  font-size: 28rpx;
  color: #ff4d4f;
  font-weight: bold;
}